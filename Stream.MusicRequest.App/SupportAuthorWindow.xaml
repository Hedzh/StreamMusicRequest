<Window x:Class="Stream.MusicRequest.App.SupportAuthorWindow"
        Icon="{StaticResource AppIcon}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поддержать автора"
        Width="460"
        Height="640"
        MinWidth="420"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111419"
        Foreground="#F2F4F7">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#181C22"/>
        <SolidColorBrush x:Key="BorderBrushDark" Color="#2C333D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F5F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A8AFBA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF7A18"/>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#252B34"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#343C47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Padding="22"
            Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource BorderBrushDark}"
            BorderThickness="1"
            CornerRadius="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Поддержать автора"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>

            <TextBlock Grid.Row="1"
                       Text="Если программа оказалась полезной, вы можете поддержать её развитие."
                       FontSize="12"
                       Foreground="{StaticResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,14"/>

            <TextBlock Grid.Row="2"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,8"
                       FontSize="13">
                <Run Text="DALink: "/>
                <Hyperlink NavigateUri="https://dalink.to/hedzh"
                           RequestNavigate="SupportLink_RequestNavigate"
                           Foreground="{StaticResource AccentBrush}">
                    <Run Text="https://dalink.to/hedzh"/>
                </Hyperlink>
            </TextBlock>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="Открыть в браузере"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="OpenSupportLinkButton_Click"/>
                <Button Content="Закрыть"
                        Style="{StaticResource SecondaryButton}"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
