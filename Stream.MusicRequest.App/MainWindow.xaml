<Window x:Class="Stream.MusicRequest.App.MainWindow"
        Icon="{StaticResource AppIcon}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream Music Request"
        Width="1380"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#111419"
        Foreground="#F2F4F7">

        <Window.Resources>

                <!-- ========================================================= -->
                <!-- COLORS -->
                <!-- ========================================================= -->

                <SolidColorBrush x:Key="WindowBackground"
                                 Color="#111419"/>

                <SolidColorBrush x:Key="PanelBackground"
                                 Color="#181C22"/>

                <SolidColorBrush x:Key="CardBackground"
                                 Color="#1D222A"/>

                <SolidColorBrush x:Key="CardBackgroundLight"
                                 Color="#232933"/>

                <SolidColorBrush x:Key="BorderBrushDark"
                                 Color="#2C333D"/>

                <SolidColorBrush x:Key="AccentBrush"
                                 Color="#FF7A18"/>

                <SolidColorBrush x:Key="AccentDarkBrush"
                                 Color="#B9540D"/>

                <SolidColorBrush x:Key="TextPrimary"
                                 Color="#F3F5F7"/>

                <SolidColorBrush x:Key="TextSecondary"
                                 Color="#A8AFBA"/>

                <SolidColorBrush x:Key="TextMuted"
                                 Color="#707784"/>

                <SolidColorBrush x:Key="SuccessBrush"
                                 Color="#55C98A"/>

                <SolidColorBrush x:Key="WarningBrush"
                                 Color="#E7B84B"/>

                <!-- ========================================================= -->
                <!-- GENERAL TEXT -->
                <!-- ========================================================= -->

                <Style x:Key="SmallLabel"
                       TargetType="TextBlock">

                        <Setter Property="FontSize"
                                Value="11"/>

                        <Setter Property="FontWeight"
                                Value="SemiBold"/>

                        <Setter Property="Foreground"
                                Value="{StaticResource TextMuted}"/>

                </Style>

                <Style x:Key="SectionTitle"
                       TargetType="TextBlock">

                        <Setter Property="FontSize"
                                Value="16"/>

                        <Setter Property="FontWeight"
                                Value="SemiBold"/>

                        <Setter Property="Foreground"
                                Value="{StaticResource TextPrimary}"/>

                </Style>

                <!-- ========================================================= -->
                <!-- BUTTON -->
                <!-- ========================================================= -->

                <Style x:Key="IconButton"
                       TargetType="Button">

                        <Setter Property="Width"
                                Value="42"/>

                        <Setter Property="Height"
                                Value="38"/>

                        <Setter Property="Background"
                                Value="#252B34"/>

                        <Setter Property="Foreground"
                                Value="{StaticResource TextPrimary}"/>

                        <Setter Property="BorderBrush"
                                Value="#343C47"/>

                        <Setter Property="BorderThickness"
                                Value="1"/>

                        <Setter Property="FontSize"
                                Value="15"/>

                        <Setter Property="Cursor"
                                Value="Hand"/>

                </Style>

                <Style x:Key="AccentButton"
                       TargetType="Button">

                        <Setter Property="Height"
                                Value="38"/>

                        <Setter Property="Padding"
                                Value="16,0"/>

                        <Setter Property="Background"
                                Value="{StaticResource AccentBrush}"/>

                        <Setter Property="Foreground"
                                Value="#FFFFFF"/>

                        <Setter Property="BorderBrush"
                                Value="{StaticResource AccentBrush}"/>

                        <Setter Property="BorderThickness"
                                Value="1"/>

                        <Setter Property="FontSize"
                                Value="13"/>

                        <Setter Property="FontWeight"
                                Value="SemiBold"/>

                        <Setter Property="Cursor"
                                Value="Hand"/>

                </Style>

                <Style x:Key="SecondaryButton"
                       TargetType="Button">

                        <Setter Property="Height"
                                Value="38"/>

                        <Setter Property="Padding"
                                Value="14,0"/>

                        <Setter Property="Background"
                                Value="#252B34"/>

                        <Setter Property="Foreground"
                                Value="{StaticResource TextPrimary}"/>

                        <Setter Property="BorderBrush"
                                Value="#343C47"/>

                        <Setter Property="BorderThickness"
                                Value="1"/>

                        <Setter Property="FontSize"
                                Value="13"/>

                        <Setter Property="Cursor"
                                Value="Hand"/>

                </Style>

                <!-- ========================================================= -->
                <!-- INPUT -->
                <!-- ========================================================= -->

                <Style x:Key="UrlTextBox"
                       TargetType="TextBox">

                        <Setter Property="Height"
                                Value="40"/>

                        <Setter Property="Padding"
                                Value="12,0"/>

                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>

                        <Setter Property="Background"
                                Value="#12161B"/>

                        <Setter Property="Foreground"
                                Value="{StaticResource TextPrimary}"/>

                        <Setter Property="BorderBrush"
                                Value="{StaticResource BorderBrushDark}"/>

                        <Setter Property="BorderThickness"
                                Value="1"/>

                        <Setter Property="FontSize"
                                Value="13"/>

                </Style>

                <!-- ========================================================= -->
                <!-- QUEUE ITEM -->
                <!-- ========================================================= -->

                <Style x:Key="QueueActionButton"
                       TargetType="Button">

                        <Setter Property="Width"
                                Value="32"/>

                        <Setter Property="Height"
                                Value="30"/>

                        <Setter Property="Background"
                                Value="#252B34"/>

                        <Setter Property="Foreground"
                                Value="{StaticResource TextSecondary}"/>

                        <Setter Property="BorderBrush"
                                Value="#343C47"/>

                        <Setter Property="BorderThickness"
                                Value="1"/>

                        <Setter Property="FontSize"
                                Value="12"/>

                </Style>

        </Window.Resources>

        <Grid Background="{StaticResource WindowBackground}"
              Margin="22">

                <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="132"/>
                </Grid.RowDefinitions>

                <!-- ========================================================= -->
                <!-- HEADER -->
                <!-- ========================================================= -->

                <Grid Grid.Row="0"
                      Margin="4,0,4,18">

                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="STREAM MUSIC REQUEST"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"/>

                                <TextBlock Text="Музыкальное управление для Twitch"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,4,0,0"/>

                        </StackPanel>

                        <!-- YANDEX STATUS -->

                        <Border Grid.Column="1"
                                Background="{StaticResource CardBackground}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,8"
                                Margin="0,0,10,0">

                                <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="{StaticResource SuccessBrush}"
                                                 VerticalAlignment="Center"/>

                                        <StackPanel Margin="8,0,0,0">

                                                <TextBlock Text="Yandex Music"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMuted}"/>

                                                <TextBlock x:Name="YandexStatusText"
                                                           Text="Подключено"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           Margin="0,1,0,0"/>

                                        </StackPanel>

                                </StackPanel>

                        </Border>

                        <!-- TWITCH STATUS -->

                        <Border Grid.Column="2"
                                Background="{StaticResource CardBackground}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,8"
                                Margin="0,0,10,0">

                                <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="{StaticResource SuccessBrush}"
                                                 VerticalAlignment="Center"/>

                                        <StackPanel Margin="8,0,0,0">

                                                <TextBlock Text="Twitch"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMuted}"/>

                                                <TextBlock x:Name="TwitchStatusText"
                                                           Text="Подключено"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           Margin="0,1,0,0"/>

                                        </StackPanel>

                                </StackPanel>

                        </Border>

                        <!-- DONATION ALERTS STATUS -->

                        <Border Grid.Column="3"
                                Background="{StaticResource CardBackground}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,8"
                                Margin="0,0,10,0">

                                <StackPanel Orientation="Horizontal">

                                        <Ellipse x:Name="DonationAlertsStatusIndicator"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="{StaticResource TextMuted}"
                                                 VerticalAlignment="Center"/>

                                        <StackPanel Margin="8,0,0,0">

                                                <TextBlock Text="Donation Alerts"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMuted}"/>

                                                <TextBlock x:Name="DonationAlertsStatusText"
                                                           Text="Не подключено"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="0,1,0,0"/>

                                        </StackPanel>

                                </StackPanel>

                        </Border>

                        <!-- SETTINGS -->

                        <Button Grid.Column="4"
                                Content="⚙"
                                Style="{StaticResource IconButton}"
                                ToolTip="Настройки"
                                Click="OpenSettingsButton_Click"/>

                </Grid>

                <!-- ========================================================= -->
                <!-- MAIN AREA -->
                <!-- ========================================================= -->

                <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.65*"/>
                                <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ===================================================== -->
                        <!-- LEFT: PLAYER -->
                        <!-- ===================================================== -->

                        <Grid Grid.Column="0"
                              Margin="0,0,12,0">

                                <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- CURRENT TRACK -->

                                <Border Grid.Row="0"
                                        Background="{StaticResource PanelBackground}"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="24">

                                        <Grid>

                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- PLAYER HEADER -->

                                                <Grid Grid.Row="0">

                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>

                                                                <TextBlock Text="СЕЙЧАС ИГРАЕТ"
                                                                           Style="{StaticResource SmallLabel}"
                                                                           Foreground="{StaticResource AccentBrush}"/>

                                                                <TextBlock x:Name="PlaybackModeText"
                                                                           Text="Основная музыка"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextSecondary}"
                                                                           Margin="0,4,0,0"/>

                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Background="#252B34"
                                                                CornerRadius="6"
                                                                Padding="10,5">

                                                                <TextBlock Text="Yandex Music"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextSecondary}"/>

                                                        </Border>

                                                </Grid>

                                                <!-- TRACK -->

                                                <Grid Grid.Row="1"
                                                      Margin="0,22,0,20">

                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- TRACK INFO -->

                                                        <StackPanel Grid.Column="0"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,0,0">

                                                                <TextBlock Text="Исполнитель"
                                                                           Style="{StaticResource SmallLabel}"
                                                                           Margin="0,0,0,8"/>

                                                                <TextBlock x:Name="CurrentArtistText"
                                                                           Text="Нет активного трека"
                                                                           FontSize="27"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#FFFFFF"
                                                                           TextWrapping="Wrap"/>

                                                                <TextBlock x:Name="CurrentTitleText"
                                                                           Text="Ожидание воспроизведения"
                                                                           FontSize="20"
                                                                           Foreground="{StaticResource TextSecondary}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,7,0,0"/>

                                                                <TextBlock x:Name="CurrentAlbumText"
                                                                           Text="—"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource TextMuted}"
                                                                           Margin="0,10,0,0"/>

                                                                <Border Background="#252B34"
                                                                        CornerRadius="6"
                                                                        Padding="9,5"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="0,18,0,0">

                                                                        <TextBlock Text="ГОТОВ К ВОСПРОИЗВЕДЕНИЮ"
                                                                                   FontSize="10"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource TextMuted}"/>

                                                                </Border>

                                                        </StackPanel>

                                                </Grid>

                                                <!-- PROGRESS + CONTROLS -->

                                                <StackPanel Grid.Row="2">

                                                        <Grid Margin="0,0,0,7">

                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock x:Name="CurrentPositionText"
                                                                           Text="00:00"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextSecondary}"
                                                                           VerticalAlignment="Center"/>

                                                                <!-- SEEK BAR -->

                                                                <Slider x:Name="PlaybackSlider"
                                                                        Grid.Column="1"
                                                                        Minimum="0"
                                                                        Maximum="100"
                                                                        Value="0"
                                                                        VerticalAlignment="Center"
                                                                        Margin="12,0"
                                                                        Cursor="Hand"/>

                                                                <TextBlock x:Name="DurationText"
                                                                           Grid.Column="2"
                                                                           Text="00:00"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextSecondary}"
                                                                           VerticalAlignment="Center"/>

                                                        </Grid>

                                                        <Grid>

                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- LEFT -->

                                                                <StackPanel Grid.Column="0"
                                                                            Orientation="Horizontal"
                                                                            VerticalAlignment="Center">

                                                                        <Button Content="↶"
                                                                                Style="{StaticResource IconButton}"
                                                                                ToolTip="Предыдущий"/>

                                                                        <Button Content="↷"
                                                                                Style="{StaticResource IconButton}"
                                                                                ToolTip="Следующий"
                                                                                Margin="7,0,0,0"/>

                                                                </StackPanel>

                                                                <!-- CENTER -->

                                                                <Button Grid.Column="1"
                                                                        Content="▶"
                                                                        Width="58"
                                                                        Height="50"
                                                                        Background="{StaticResource AccentBrush}"
                                                                        Foreground="#FFFFFF"
                                                                        BorderBrush="{StaticResource AccentBrush}"
                                                                        BorderThickness="1"
                                                                        FontSize="20"
                                                                        FontWeight="Bold"
                                                                        Cursor="Hand"
                                                                        ToolTip="Воспроизвести / пауза"/>

                                                                <!-- RIGHT -->

                                                                <StackPanel Grid.Column="2"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center">

                                                                        <TextBlock Text="🔊"
                                                                                   FontSize="14"
                                                                                   Foreground="{StaticResource TextSecondary}"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,0,8,0"/>

                                                                        <Slider x:Name="VolumeSlider"
                                                                                Width="130"
                                                                                Minimum="0"
                                                                                Maximum="100"
                                                                                Value="75"
                                                                                VerticalAlignment="Center"
                                                                                Cursor="Hand"/>

                                                                </StackPanel>

                                                        </Grid>

                                                </StackPanel>

                                        </Grid>

                                </Border>

                                <!-- MANUAL ADD -->

                                <Grid Grid.Row="1"
                                      Margin="0,12,0,0">

                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- VIEWER REQUEST -->

                                        <Border Grid.Row="0"
                                                Background="{StaticResource PanelBackground}"
                                                BorderBrush="{StaticResource BorderBrushDark}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="18">

                                                <Grid>

                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,16,0">

                                                                <TextBlock Text="ЗАЯВКА ЗРИТЕЛЯ"
                                                                           Style="{StaticResource SmallLabel}"
                                                                           Foreground="{StaticResource AccentBrush}"/>

                                                                <TextBlock Text="Только трек"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimary}"
                                                                           Margin="0,3,0,0"/>

                                                        </StackPanel>

                                                        <TextBox x:Name="TrackUrlTextBox"
                                                                 Grid.Column="1"
                                                                 Style="{StaticResource UrlTextBox}"
                                                                 VerticalAlignment="Center"
                                                                 ToolTip="Вставьте ссылку на трек Yandex Music"/>

                                                        <Button x:Name="AddRequestButton"
                                                                Grid.Column="2"
                                                                Content="Добавить"
                                                                Style="{StaticResource AccentButton}"
                                                                Width="105"
                                                                Margin="10,0,0,0"
                                                                Click="AddRequestButton_Click"/>

                                                </Grid>

                                        </Border>

                                        <!-- MAIN MUSIC -->

                                        <Border Grid.Row="1"
                                                Background="{StaticResource PanelBackground}"
                                                BorderBrush="{StaticResource BorderBrushDark}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="18"
                                                Margin="0,10,0,0">

                                                <Grid>

                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,16,0">

                                                                <TextBlock Text="ОСНОВНАЯ МУЗЫКА"
                                                                           Style="{StaticResource SmallLabel}"
                                                                           Foreground="{StaticResource AccentBrush}"/>

                                                                <TextBlock Text="Альбом или плейлист"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimary}"
                                                                           Margin="0,3,0,0"/>

                                                        </StackPanel>

                                                        <TextBox x:Name="MainMusicUrlTextBox"
                                                                 Grid.Column="1"
                                                                 Style="{StaticResource UrlTextBox}"
                                                                 VerticalAlignment="Center"
                                                                 ToolTip="Вставьте ссылку на альбом или плейлист Yandex Music"/>

                                                        <Button x:Name="SetMainMusicButton"
                                                                Grid.Column="2"
                                                                Content="Загрузить"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Width="105"
                                                                Margin="10,0,0,0"/>

                                                </Grid>

                                        </Border>

                                </Grid>

                        </Grid>

                        <!-- ===================================================== -->
                        <!-- RIGHT: QUEUE -->
                        <!-- ===================================================== -->

                        <Grid Grid.Column="1">

                                <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- QUEUE -->

                                <Border Grid.Row="0"
                                        Background="{StaticResource PanelBackground}"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20">

                                        <Grid>

                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- HEADER -->

                                                <Grid Grid.Row="0">

                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>

                                                                <TextBlock Text="ОЧЕРЕДЬ ЗРИТЕЛЕЙ"
                                                                           Style="{StaticResource SectionTitle}"/>

                                                                <TextBlock Text="Запросы, ожидающие воспроизведения"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextMuted}"
                                                                           Margin="0,4,0,0"/>

                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Background="#252B34"
                                                                CornerRadius="7"
                                                                Padding="11,6">

                                                                <TextBlock x:Name="QueueStatusText"
                                                                           Text="В очереди: 0"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextSecondary}"/>

                                                        </Border>

                                                </Grid>

                                                <!-- SEPARATOR -->

                                                <Border Grid.Row="1"
                                                        Height="1"
                                                        Background="{StaticResource BorderBrushDark}"
                                                        Margin="0,16,0,10"/>

                                                <!-- QUEUE LIST -->

                                                <ScrollViewer Grid.Row="2"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">

                                                        <StackPanel x:Name="QueueItemsPanel">

                                                                <!-- EMPTY STATE -->

                                                                <Border x:Name="EmptyQueueState"
                                                                        Background="#15191F"
                                                                        CornerRadius="8"
                                                                        Padding="20"
                                                                        Margin="0,0,0,10">

                                                                        <StackPanel HorizontalAlignment="Center">

                                                                                <TextBlock Text="♪"
                                                                                           FontSize="30"
                                                                                           Foreground="#454D59"
                                                                                           HorizontalAlignment="Center"/>

                                                                                <TextBlock Text="Очередь пуста"
                                                                                           FontSize="14"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{StaticResource TextSecondary}"
                                                                                           HorizontalAlignment="Center"
                                                                                           Margin="0,8,0,0"/>

                                                                                <TextBlock Text="Новые заказы зрителей появятся здесь"
                                                                                           FontSize="11"
                                                                                           Foreground="{StaticResource TextMuted}"
                                                                                           HorizontalAlignment="Center"
                                                                                           Margin="0,4,0,0"/>

                                                                        </StackPanel>

                                                                </Border>

                                                        </StackPanel>

                                                </ScrollViewer>

                                                <!-- FOOTER -->

                                                <Border Grid.Row="3"
                                                        Background="#15191F"
                                                        CornerRadius="8"
                                                        Padding="12"
                                                        Margin="0,10,0,0">

                                                        <StackPanel>

                                                                <TextBlock Text="РЕЖИМ"
                                                                           Style="{StaticResource SmallLabel}"/>

                                                                <TextBlock Text="Основной альбом → запросы зрителей → продолжение альбома"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextSecondary}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,5,0,0"/>

                                                        </StackPanel>

                                                </Border>

                                        </Grid>

                                </Border>

                                <!-- MAIN ALBUM -->

                                <Border Grid.Row="1"
                                        Background="{StaticResource PanelBackground}"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="16"
                                        Margin="0,12,0,0">

                                        <Grid>

                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>

                                                        <TextBlock Text="ОСНОВНОЙ АЛЬБОМ"
                                                                   Style="{StaticResource SmallLabel}"
                                                                   Foreground="{StaticResource AccentBrush}"/>

                                                        <TextBlock x:Name="MainAlbumTitleText"
                                                                   Text="Не выбран"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0"/>

                                                        <TextBlock x:Name="MainAlbumInfoText"
                                                                   Text="Добавьте альбом или плейлист Yandex Music"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0"/>

                                                        <TextBlock Text="Альбом стримера возобновится после очистки очереди."
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0"/>

                                                </StackPanel>

                                                <Button x:Name="ShuffleMainMusicButton"
                                                        Grid.Column="1"
                                                        Content="🔀"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="Случайный порядок"
                                                        VerticalAlignment="Center"/>

                                        </Grid>

                                </Border>

                        </Grid>

                </Grid>

                <!-- ========================================================= -->
                <!-- BOTTOM STATUS -->
                <!-- ========================================================= -->

                <Border Grid.Row="2"
                        Background="#15191F"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,14,0,0">

