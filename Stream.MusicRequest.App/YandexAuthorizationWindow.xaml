<Window x:Class="Stream.MusicRequest.App.YandexAuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация Yandex Music"
        Width="520"
        Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#121212"
        Foreground="#FFFFFF">

    <Border
        Background="#181818"
        BorderBrush="#303030"
        BorderThickness="1"
        CornerRadius="14"
        Padding="28">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE -->

            <TextBlock Grid.Row="0"
                       Text="Авторизация Yandex Music"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"/>

            <TextBlock Grid.Row="1"
                       Text="Откройте страницу Yandex и введите код устройства."
                       FontSize="13"
                       Foreground="#9A9A9A"
                       TextWrapping="Wrap"
                       Margin="0,8,0,22"/>

            <!-- URL -->

            <TextBlock Grid.Row="2"
                       Text="Страница авторизации"
                       FontSize="11"
                       Foreground="#7F7F7F"/>

            <TextBlock x:Name="VerificationUrlText"
                       Grid.Row="3"
                       Text=""
                       FontSize="14"
                       Foreground="#FF9F1C"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"/>

            <!-- CODE -->

            <Border Grid.Row="4"
                    Background="#202020"
                    BorderBrush="#343434"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,18,0,18">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="КОД УСТРОЙСТВА"
                               FontSize="10"
                               Foreground="#7F7F7F"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="UserCodeText"
                               Text=""
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>

                </StackPanel>

            </Border>

            <!-- BUTTONS -->

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Открыть страницу"
                        Style="{StaticResource AccentButton}"
                        Width="145"
                        Margin="0,0,8,0"
                        Click="OpenVerificationUrlButton_Click"/>

                <Button Content="Закрыть"
                        Style="{StaticResource SecondaryButton}"
                        Width="90"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>