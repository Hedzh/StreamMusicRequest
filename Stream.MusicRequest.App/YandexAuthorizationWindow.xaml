<Window x:Class="Stream.MusicRequest.App.YandexAuthorizationWindow"
        Icon="{StaticResource AppIcon}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация Yandex Music"
        Width="560"
        Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#121212"
        Foreground="#FFFFFF">

    <Window.Resources>

        <Style x:Key="AuthAccentButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="Background"
                    Value="#FF7A18"/>

            <Setter Property="BorderBrush"
                    Value="#FF7A18"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

        <Style x:Key="AuthSecondaryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#F2F4F7"/>

            <Setter Property="Background"
                    Value="#292E37"/>

            <Setter Property="BorderBrush"
                    Value="#363D48"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>

    <Border Background="#181818"
            BorderBrush="#303030"
            BorderThickness="1"
            CornerRadius="14"
            Padding="28">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Авторизация Yandex Music"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"/>

            <TextBlock Grid.Row="1"
                       Text="Откройте страницу Yandex и введите код устройства."
                       FontSize="13"
                       Foreground="#9A9A9A"
                       TextWrapping="Wrap"
                       Margin="0,8,0,22"/>

            <TextBlock Grid.Row="2"
                       Text="Страница авторизации"
                       FontSize="11"
                       Foreground="#7F7F7F"/>

            <TextBox x:Name="VerificationUrlText"
                     Grid.Row="3"
                     Text=""
                     FontSize="13"
                     Foreground="#FF9F1C"
                     Background="#202020"
                     BorderBrush="#343434"
                     BorderThickness="1"
                     Padding="10,8"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Margin="0,6,0,0"/>

            <Border Grid.Row="4"
                    Background="#202020"
                    BorderBrush="#343434"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,16,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="КОД УСТРОЙСТВА"
                                   FontSize="10"
                                   Foreground="#7F7F7F"/>

                        <TextBox x:Name="UserCodeText"
                                 Text=""
                                 FontSize="28"
                                 FontWeight="Bold"
                                 Foreground="#FFFFFF"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 IsReadOnly="True"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 Margin="0,5,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Копировать"
                            Style="{StaticResource AuthSecondaryButton}"
                            Width="110"
                            VerticalAlignment="Center"
                            Click="CopyCodeButton_Click"/>

                </Grid>

            </Border>

            <TextBlock Grid.Row="5"
                       Text="Окно можно закрыть после открытия страницы. Авторизация продолжится автоматически."
                       FontSize="11"
                       Foreground="#707784"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="2,14,0,14"/>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Открыть страницу"
                        Style="{StaticResource AuthAccentButton}"
                        Width="150"
                        Margin="0,0,8,0"
                        Click="OpenVerificationUrlButton_Click"/>

                <Button Content="Закрыть"
                        Style="{StaticResource AuthSecondaryButton}"
                        Width="90"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>