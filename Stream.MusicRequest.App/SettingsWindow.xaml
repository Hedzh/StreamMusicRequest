<Window x:Class="Stream.MusicRequest.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Stream Music Request"
        Width="1180"
        Height="760"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#15181E"
        Foreground="#F2F4F7">

    <Window.Resources>

        <SolidColorBrush x:Key="WindowBackground"
                         Color="#15181E"/>

        <SolidColorBrush x:Key="SidebarBackground"
                         Color="#111419"/>

        <SolidColorBrush x:Key="CardBackground"
                         Color="#1C2027"/>

        <SolidColorBrush x:Key="BorderBrushDark"
                         Color="#2B313B"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#FF7A18"/>

        <SolidColorBrush x:Key="TextPrimary"
                         Color="#F2F4F7"/>

        <SolidColorBrush x:Key="TextSecondary"
                         Color="#A8AFBA"/>

        <SolidColorBrush x:Key="TextMuted"
                         Color="#707784"/>

        <SolidColorBrush x:Key="SuccessBrush"
                         Color="#55C98A"/>

        <SolidColorBrush x:Key="WarningBrush"
                         Color="#E0A458"/>

        <!-- ====================================================== -->
        <!-- PAGE -->
        <!-- ====================================================== -->

        <Style x:Key="PageTitle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="26"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

        </Style>

        <Style x:Key="PageDescription"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondary}"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

        </Style>

        <Style x:Key="SectionTitle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>

            <Setter Property="Margin"
                    Value="0,0,0,12"/>

        </Style>

        <Style x:Key="FieldTitle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>

            <Setter Property="Margin"
                    Value="0,0,0,5"/>

        </Style>

        <Style x:Key="FieldDescription"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextMuted}"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

            <Setter Property="Margin"
                    Value="0,4,0,0"/>

        </Style>

        <!-- ====================================================== -->
        <!-- CARD -->
        <!-- ====================================================== -->

        <Style x:Key="SettingsCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource CardBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrushDark}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="20"/>

            <Setter Property="Margin"
                    Value="0,0,0,14"/>

        </Style>

        <!-- ====================================================== -->
        <!-- TEXT INPUT -->
        <!-- ====================================================== -->

        <Style x:Key="InputBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="11,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>

            <Setter Property="Background"
                    Value="#15181E"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrushDark}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

        <!-- ====================================================== -->
        <!-- COMBOBOX -->
        <!-- ====================================================== -->

        <Style x:Key="ComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="#111419"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrushDark}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10,0"/>

        </Style>

        <!-- ====================================================== -->
        <!-- COMBOBOX ITEMS -->
        <!-- ====================================================== -->

        <Style TargetType="ComboBoxItem">

            <Setter Property="Foreground"
                    Value="#111419"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- ====================================================== -->
        <!-- BUTTONS -->
        <!-- ====================================================== -->

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>

            <Setter Property="Background"
                    Value="#292E37"/>

            <Setter Property="BorderBrush"
                    Value="#363D48"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

        <Style x:Key="AccentButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="Background"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

        <!-- ====================================================== -->
        <!-- NAVIGATION -->
        <!-- ====================================================== -->

        <Style x:Key="NavigationItemStyle"
               TargetType="ListBoxItem">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Margin"
                    Value="0,2,0,2"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondary}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="NavigationBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="2,0,0,0"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="NavigationBackground"
                                        Property="Background"
                                        Value="#1C2027"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="NavigationBackground"
                                        Property="Background"
                                        Value="#292E37"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                                <Setter TargetName="NavigationBackground"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ====================================================== -->
        <!-- RADIO / CHECKBOX -->
        <!-- ====================================================== -->

        <Style x:Key="SettingsRadioButton"
               TargetType="RadioButton">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>

            <Setter Property="Margin"
                    Value="0,4,0,4"/>

        </Style>

        <Style x:Key="SettingsCheckBox"
               TargetType="CheckBox">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>

            <Setter Property="Margin"
                    Value="0,6,0,6"/>

        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================================== -->
        <!-- SIDEBAR -->
        <!-- ====================================================== -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="86"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="24,20,20,0">

                    <TextBlock Text="STREAM MUSIC"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"/>

                    <TextBlock Text="REQUEST"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,2,0,0"/>

                </StackPanel>

                <ListBox x:Name="NavigationList"
                         Grid.Row="1"
                         Margin="12,8,12,12"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectedIndex="0"
                         SelectionChanged="NavigationList_SelectionChanged"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}">

                    <ListBoxItem>
                        <TextBlock Text="Общие"/>
                    </ListBoxItem>

                    <ListBoxItem>
                        <TextBlock Text="Музыкальные источники"/>
                    </ListBoxItem>

                    <ListBoxItem>
                        <TextBlock Text="Twitch"/>
                    </ListBoxItem>

                    <ListBoxItem>
                        <TextBlock Text="Twitch → Награды"/>
                    </ListBoxItem>

                    <ListBoxItem>
                        <TextBlock Text="Donation Alerts"/>
                    </ListBoxItem>

                    <ListBoxItem>
                        <TextBlock Text="Воспроизведение"/>
                    </ListBoxItem>

                    <ListBoxItem>
                        <TextBlock Text="OBS / Виджет"/>
                    </ListBoxItem>

                    <ListBoxItem>
                        <TextBlock Text="История изменений"/>
                    </ListBoxItem>

                </ListBox>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="0,1,0,0"
                        Padding="24,0">

                    <TextBlock Text="Stream Music Request"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"/>

                </Border>

            </Grid>

        </Border>

        <!-- ====================================================== -->
        <!-- MAIN CONTENT -->
        <!-- ====================================================== -->

        <Grid Grid.Column="1"
              Margin="30,26,30,24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="НАСТРОЙКИ"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Закрыть"
                        Style="{StaticResource ActionButton}"
                        Width="90"
                        IsCancel="True"/>

            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,24,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid>

                    <!-- ================================================== -->
                    <!-- GENERAL -->
                    <!-- ================================================== -->

                    <StackPanel x:Name="GeneralPage">

                        <TextBlock Text="Общие"
                                   Style="{StaticResource PageTitle}"/>

                        <TextBlock Text="Основная информация о приложении."
                                   Style="{StaticResource PageDescription}"
                                   Margin="0,0,0,20"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <StackPanel>

                                <TextBlock Text="Stream Music Request"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"/>

                                <TextBlock Text="Управление музыкальными запросами зрителей Twitch."
                                           FontSize="14"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,8,0,0"/>

                                <TextBlock Text="Приложение позволяет принимать музыкальные запросы, управлять очередью и воспроизводить музыку во время стрима."
                                           Style="{StaticResource FieldDescription}"
                                           Margin="0,14,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Style="{StaticResource SettingsCard}">

                            <StackPanel>

                                <TextBlock Text="Язык интерфейса"
                                           Style="{StaticResource SectionTitle}"/>

                                <ComboBox Style="{StaticResource ComboBoxStyle}"
                                          Width="220"
                                          HorizontalAlignment="Left"
                                          SelectedIndex="0">

                                    <ComboBoxItem Content="Русский"/>
                                    <ComboBoxItem Content="English"/>

                                </ComboBox>

                            </StackPanel>

                        </Border>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Версия приложения"
                                               Style="{StaticResource FieldTitle}"/>

                                    <TextBlock Text="Текущая версия установленного приложения."
                                               Style="{StaticResource FieldDescription}"/>

                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="1.1.0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <Border Style="{StaticResource SettingsCard}">

                            <StackPanel>

                                <TextBlock Text="Диагностика"
                                           Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="Открыть папку с журналами приложения для просмотра текущего app.log и других логов."
                                           Style="{StaticResource FieldDescription}"
                                           Margin="0,0,0,14"/>

                                <Button Content="Открыть папку логов"
                                        Click="OpenLogsButton_Click"
                                        Style="{StaticResource ActionButton}"
                                        Width="170"
                                        HorizontalAlignment="Left"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- MUSIC SOURCES -->
                    <!-- ================================================== -->

                    <StackPanel x:Name="MusicSourcesPage"
                                Visibility="Collapsed">

                        <TextBlock Text="Музыкальные источники"
                                   Style="{StaticResource PageTitle}"/>

                        <TextBlock Text="Подключение сервисов, из которых приложение получает музыку."
                                   Style="{StaticResource PageDescription}"
                                   Margin="0,0,0,20"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Yandex Music"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,8,0,0">

                                        <Ellipse x:Name="YandexStatusIndicator"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="{StaticResource TextMuted}"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock x:Name="YandexStatusText"
                                                   Text="Не авторизован"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="12"
                                                   Margin="7,0,0,0"/>

                                    </StackPanel>

                                    <TextBlock Text="Используется для основной музыки и музыкальных запросов зрителей."
                                               Style="{StaticResource FieldDescription}"
                                               Margin="0,10,0,0"/>

                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <Button x:Name="YandexAuthorizeButton"
                                            Content="Авторизоваться"
                                            Style="{StaticResource AccentButton}"
                                            Width="150"
                                            Margin="0,0,8,0"
                                            Click="YandexAuthorizeButton_Click"/>

                                    <Button x:Name="YandexLogoutButton"
                                            Content="Выйти"
                                            Style="{StaticResource ActionButton}"
                                            Width="80"
                                            Click="YandexLogoutButton_Click"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- TWITCH -->
                    <!-- ================================================== -->

                    <StackPanel x:Name="TwitchPage"
                                Visibility="Collapsed">

                        <TextBlock Text="Twitch"
                                   Style="{StaticResource PageTitle}"/>

                        <TextBlock Text="Подключение Twitch-канала к приложению."
                                   Style="{StaticResource PageDescription}"
                                   Margin="0,0,0,20"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <StackPanel>

                                <TextBlock Text="Состояние подключения"
                                           Style="{StaticResource SectionTitle}"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal">

                                            <Ellipse x:Name="TwitchStatusIndicator"
                                                     Width="9"
                                                     Height="9"
                                                     Fill="{StaticResource TextMuted}"
                                                     VerticalAlignment="Center"/>

                                            <TextBlock x:Name="TwitchStatusText"
                                                       Text="Не авторизован"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontWeight="SemiBold"
                                                       Margin="8,0,0,0"/>

                                        </StackPanel>

                                        <TextBlock x:Name="TwitchChannelText"
                                                   Text="Канал: —"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="17,7,0,0"/>

                                    </StackPanel>

                                    <Button x:Name="TwitchLogoutButton"
                                            Grid.Column="1"
                                            Content="Выйти"
                                            Style="{StaticResource ActionButton}"
                                            Width="90"
                                            VerticalAlignment="Center"
                                            IsEnabled="False"
                                            Click="TwitchLogoutButton_Click"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <Border Style="{StaticResource SettingsCard}">

                            <StackPanel>

                                <TextBlock Text="Авторизация Twitch"
                                           Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="Для работы наград и получения событий канала необходимо авторизовать приложение в Twitch."
                                           Style="{StaticResource FieldDescription}"
                                           Margin="0,0,0,14"/>

                                <Button x:Name="TwitchAuthorizeButton"
                                        Content="Авторизоваться в Twitch"
                                        Style="{StaticResource AccentButton}"
                                        Width="190"
                                        HorizontalAlignment="Left"
                                        Click="TwitchAuthorizeButton_Click"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- TWITCH REWARDS -->
                    <!-- ================================================== -->

                    <StackPanel x:Name="TwitchRewardsPage"
                                Visibility="Collapsed">

                        <TextBlock Text="Twitch → Награды"
                                   Style="{StaticResource PageTitle}"/>

                        <TextBlock Text="Привязка существующих наград Twitch к функциям приложения."
                                   Style="{StaticResource PageDescription}"
                                   Margin="0,0,0,20"/>

                        <!-- ORDER MUSIC -->

                        <Border Style="{StaticResource SettingsCard}">

                            <StackPanel>

                                <TextBlock Text="Заказ музыки"
                                           Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="Reward ID"
                                           Style="{StaticResource FieldTitle}"/>

                                <TextBox x:Name="OrderMusicRewardIdTextBox"
                                         Style="{StaticResource InputBox}"
                                         Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">

                                    <Button Content="Проверить"
                                            Style="{StaticResource ActionButton}"
                                            Width="105"
                                            Margin="0,0,8,0"
                                            Click="OrderMusicRewardCheckButton_Click"/>

                                    <Button Content="Сохранить"
                                            Style="{StaticResource AccentButton}"
                                            Width="105"
                                            Margin="0,0,8,0"
                                            Click="OrderMusicRewardSaveButton_Click"/>

                                    <Button Content="Очистить"
                                            Style="{StaticResource ActionButton}"
                                            Width="105"
                                            Click="OrderMusicRewardClearButton_Click"/>

                                </StackPanel>

                                <Border Background="#15181E"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,14,0,0">

                                    <StackPanel>

                                        <TextBlock>
                                            <Run Text="Статус: "/>
                                            <Run x:Name="OrderMusicRewardStatusText"
                                                 Text="Не проверена"
                                                 FontWeight="SemiBold"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,7,0,0">
                                            <Run Text="Название: "/>
                                            <Run x:Name="OrderMusicRewardNameText"
                                                 Text="—"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,5,0,0">
                                            <Run Text="Стоимость: "/>
                                            <Run x:Name="OrderMusicRewardCostText"
                                                 Text="—"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,5,0,0">
                                            <Run Text="Ввод пользователя: "/>
                                            <Run x:Name="OrderMusicRewardInputText"
                                                 Text="—"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,5,0,0"
                                                   TextWrapping="Wrap">
                                            <Run Text="Включена: "/>
                                            <Run x:Name="OrderMusicRewardEnabledText"
                                                 Text="—"/>
                                        </TextBlock>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Border>

                        <!-- SKIP TRACK -->

                        <Border Style="{StaticResource SettingsCard}">

                            <StackPanel>

                                <TextBlock Text="Пропустить трек"
                                           Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="Reward ID"
                                           Style="{StaticResource FieldTitle}"/>

                                <TextBox x:Name="SkipTrackRewardIdTextBox"
                                         Style="{StaticResource InputBox}"
                                         Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">

                                    <Button Content="Проверить"
                                            Style="{StaticResource ActionButton}"
                                            Width="105"
                                            Margin="0,0,8,0"
                                            Click="SkipTrackRewardCheckButton_Click"/>

                                    <Button Content="Сохранить"
                                            Style="{StaticResource AccentButton}"
                                            Width="105"
                                            Margin="0,0,8,0"
                                            Click="SkipTrackRewardSaveButton_Click"/>

                                    <Button Content="Очистить"
                                            Style="{StaticResource ActionButton}"
                                            Width="105"
                                            Click="SkipTrackRewardClearButton_Click"/>

                                </StackPanel>

                                <Border Background="#15181E"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,14,0,0">

                                    <StackPanel>

                                        <TextBlock>
                                            <Run Text="Статус: "/>
                                            <Run x:Name="SkipTrackRewardStatusText"
                                                 Text="Не проверена"
                                                 FontWeight="SemiBold"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,7,0,0">
                                            <Run Text="Название: "/>
                                            <Run x:Name="SkipTrackRewardNameText"
                                                 Text="—"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,5,0,0">
                                            <Run Text="Стоимость: "/>
                                            <Run x:Name="SkipTrackRewardCostText"
                                                 Text="—"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,5,0,0">
                                            <Run Text="Ввод пользователя: "/>
                                            <Run x:Name="SkipTrackRewardInputText"
                                                 Text="—"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,5,0,0">
                                            <Run Text="Включена: "/>
                                            <Run x:Name="SkipTrackRewardEnabledText"
                                                 Text="—"/>
                                        </TextBlock>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- DONATION ALERTS -->
                    <!-- ================================================== -->

                    <StackPanel x:Name="DonationAlertsPage"
                                Visibility="Collapsed">

                        <TextBlock Text="Donation Alerts"
                                   Style="{StaticResource PageTitle}"/>

                        <TextBlock Text="Подключение Donation Alerts и обработка музыкальных заказов из сообщений донатов."
                                   Style="{StaticResource PageDescription}"
                                   Margin="0,0,0,20"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Подключение"
                                               Style="{StaticResource SectionTitle}"/>

