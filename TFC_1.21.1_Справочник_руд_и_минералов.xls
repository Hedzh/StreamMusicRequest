<?xml version="1.0" encoding="UTF-8"?><?mso-application progid="Excel.Sheet"?><Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet" xmlns:html="http://www.w3.org/TR/REC-html40"><Styles><Style ss:ID="Default" ss:Name="Normal"><Alignment ss:Vertical="Top" ss:WrapText="1"/><Font ss:FontName="Arial" ss:Size="10"/></Style><Style ss:ID="Header"><Interior ss:Color="#17365D" ss:Pattern="Solid"/><Font ss:Color="#FFFFFF" ss:Bold="1"/><Alignment ss:Vertical="Center" ss:WrapText="1"/></Style></Styles><Worksheet ss:Name="По породам"><Table><Row><Cell ss:StyleID="Header"><Data ss:Type="String">Геологическая группа</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Порода (рус.)</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Rock (EN)</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Металлические руды</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Минералы и топливо</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Самоцветы</Data></Cell></Row><Row><Cell><Data ss:Type="String">Осадочные</Data></Cell><Cell><Data ss:Type="String">Аргиллит</Data></Cell><Cell><Data ss:Type="String">Claystone</Data></Cell><Cell><Data ss:Type="String">Висмутин; магнетит; лимонит</Data></Cell><Cell><Data ss:Type="String">Лигнит; битумный уголь; селитра; гипс; галит; сильвит; бура</Data></Cell><Cell><Data ss:Type="String">Аметист; опал</Data></Cell></Row><Row><Cell><Data ss:Type="String">Осадочные</Data></Cell><Cell><Data ss:Type="String">Доломит</Data></Cell><Cell><Data ss:Type="String">Dolomite</Data></Cell><Cell><Data ss:Type="String">Висмутин; магнетит; лимонит; малахит</Data></Cell><Cell><Data ss:Type="String">Лигнит; битумный уголь; селитра; гипс; галит</Data></Cell><Cell><Data ss:Type="String">Аметист; опал</Data></Cell></Row><Row><Cell><Data ss:Type="String">Осадочные</Data></Cell><Cell><Data ss:Type="String">Известняк</Data></Cell><Cell><Data ss:Type="String">Limestone</Data></Cell><Cell><Data ss:Type="String">Висмутин; магнетит; лимонит; малахит</Data></Cell><Cell><Data ss:Type="String">Лигнит; битумный уголь; селитра; гипс; галит; бура</Data></Cell><Cell><Data ss:Type="String">Лазурит; аметист; опал</Data></Cell></Row><Row><Cell><Data ss:Type="String">Осадочные</Data></Cell><Cell><Data ss:Type="String">Конгломерат</Data></Cell><Cell><Data ss:Type="String">Conglomerate</Data></Cell><Cell><Data ss:Type="String">Висмутин; магнетит; лимонит</Data></Cell><Cell><Data ss:Type="String">Лигнит; битумный уголь; селитра; гипс; галит</Data></Cell><Cell><Data ss:Type="String">Аметист; опал</Data></Cell></Row><Row><Cell><Data ss:Type="String">Осадочные</Data></Cell><Cell><Data ss:Type="String">Кремнистый сланец</Data></Cell><Cell><Data ss:Type="String">Chert</Data></Cell><Cell><Data ss:Type="String">Висмутин; магнетит; лимонит</Data></Cell><Cell><Data ss:Type="String">Лигнит; битумный уголь; селитра; сильвит; гипс; галит</Data></Cell><Cell><Data ss:Type="String">Аметист; опал</Data></Cell></Row><Row><Cell><Data ss:Type="String">Осадочные</Data></Cell><Cell><Data ss:Type="String">Мел</Data></Cell><Cell><Data ss:Type="String">Chalk</Data></Cell><Cell><Data ss:Type="String">Висмутин; магнетит; лимонит; малахит</Data></Cell><Cell><Data ss:Type="String">Лигнит; битумный уголь; селитра; гипс; галит</Data></Cell><Cell><Data ss:Type="String">Аметист; опал</Data></Cell></Row><Row><Cell><Data ss:Type="String">Осадочные</Data></Cell><Cell><Data ss:Type="String">Песчаник</Data></Cell><Cell><Data ss:Type="String">Sandstone</Data></Cell><Cell><Data ss:Type="String">Висмутин; магнетит; лимонит</Data></Cell><Cell><Data ss:Type="String">Лигнит; битумный уголь; селитра; гипс; галит</Data></Cell><Cell><Data ss:Type="String">Аметист; опал</Data></Cell></Row><Row><Cell><Data ss:Type="String">Осадочные</Data></Cell><Cell><Data ss:Type="String">Сланец</Data></Cell><Cell><Data ss:Type="String">Shale</Data></Cell><Cell><Data ss:Type="String">Висмутин; магнетит; лимонит</Data></Cell><Cell><Data ss:Type="String">Лигнит; битумный уголь; селитра; сильвит; бура; гипс; галит</Data></Cell><Cell><Data ss:Type="String">Аметист; опал</Data></Cell></Row><Row><Cell><Data ss:Type="String">Метаморфические</Data></Cell><Cell><Data ss:Type="String">Аспидный сланец</Data></Cell><Cell><Data ss:Type="String">Slate</Data></Cell><Cell><Data ss:Type="String">Тетраэдрит; самородное серебро</Data></Cell><Cell><Data ss:Type="String">Сера</Data></Cell><Cell><Data ss:Type="String">Аметист</Data></Cell></Row><Row><Cell><Data ss:Type="String">Метаморфические</Data></Cell><Cell><Data ss:Type="String">Гнейс</Data></Cell><Cell><Data ss:Type="String">Gneiss</Data></Cell><Cell><Data ss:Type="String">Тетраэдрит; самородное серебро</Data></Cell><Cell><Data ss:Type="String">Сера; графит; киноварь</Data></Cell><Cell><Data ss:Type="String">Аметист</Data></Cell></Row><Row><Cell><Data ss:Type="String">Метаморфические</Data></Cell><Cell><Data ss:Type="String">Кварцит</Data></Cell><Cell><Data ss:Type="String">Quartzite</Data></Cell><Cell><Data ss:Type="String">Тетраэдрит</Data></Cell><Cell><Data ss:Type="String">Сера; графит; киноварь</Data></Cell><Cell><Data ss:Type="String">Аметист</Data></Cell></Row><Row><Cell><Data ss:Type="String">Метаморфические</Data></Cell><Cell><Data ss:Type="String">Мрамор</Data></Cell><Cell><Data ss:Type="String">Marble</Data></Cell><Cell><Data ss:Type="String">Тетраэдрит; малахит</Data></Cell><Cell><Data ss:Type="String">Сера; графит</Data></Cell><Cell><Data ss:Type="String">Лазурит; рубин; аметист</Data></Cell></Row><Row><Cell><Data ss:Type="String">Метаморфические</Data></Cell><Cell><Data ss:Type="String">Филлит</Data></Cell><Cell><Data ss:Type="String">Phyllite</Data></Cell><Cell><Data ss:Type="String">Тетраэдрит</Data></Cell><Cell><Data ss:Type="String">Сера; киноварь</Data></Cell><Cell><Data ss:Type="String">Аметист</Data></Cell></Row><Row><Cell><Data ss:Type="String">Метаморфические</Data></Cell><Cell><Data ss:Type="String">Сланец</Data></Cell><Cell><Data ss:Type="String">Schist</Data></Cell><Cell><Data ss:Type="String">Тетраэдрит; самородное серебро</Data></Cell><Cell><Data ss:Type="String">Сера; графит; киноварь</Data></Cell><Cell><Data ss:Type="String">Аметист</Data></Cell></Row><Row><Cell><Data ss:Type="String">Эффузивные магматические</Data></Cell><Cell><Data ss:Type="String">Андезит</Data></Cell><Cell><Data ss:Type="String">Andesite</Data></Cell><Cell><Data ss:Type="String">Самородная медь; самородное золото; гематит; сфалерит</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell><Cell><Data ss:Type="String">Опал; пирит</Data></Cell></Row><Row><Cell><Data ss:Type="String">Эффузивные магматические</Data></Cell><Cell><Data ss:Type="String">Базальт</Data></Cell><Cell><Data ss:Type="String">Basalt</Data></Cell><Cell><Data ss:Type="String">Самородная медь; самородное золото; гематит; сфалерит</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell><Cell><Data ss:Type="String">Опал; пирит</Data></Cell></Row><Row><Cell><Data ss:Type="String">Эффузивные магматические</Data></Cell><Cell><Data ss:Type="String">Дацит</Data></Cell><Cell><Data ss:Type="String">Dacite</Data></Cell><Cell><Data ss:Type="String">Самородная медь; самородное золото; гематит; сфалерит</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell><Cell><Data ss:Type="String">Опал; пирит</Data></Cell></Row><Row><Cell><Data ss:Type="String">Эффузивные магматические</Data></Cell><Cell><Data ss:Type="String">Риолит</Data></Cell><Cell><Data ss:Type="String">Rhyolite</Data></Cell><Cell><Data ss:Type="String">Самородная медь; самородное золото; гематит; сфалерит</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell><Cell><Data ss:Type="String">Опал; пирит</Data></Cell></Row><Row><Cell><Data ss:Type="String">Интрузивные магматические</Data></Cell><Cell><Data ss:Type="String">Габбро</Data></Cell><Cell><Data ss:Type="String">Gabbro</Data></Cell><Cell><Data ss:Type="String">Самородное золото; касситерит; висмутин; гарниерит; сфалерит</Data></Cell><Cell><Data ss:Type="String">Сера</Data></Cell><Cell><Data ss:Type="String">Изумруд; кимберлит; пирит</Data></Cell></Row><Row><Cell><Data ss:Type="String">Интрузивные магматические</Data></Cell><Cell><Data ss:Type="String">Гранит</Data></Cell><Cell><Data ss:Type="String">Granite</Data></Cell><Cell><Data ss:Type="String">Самородное серебро; самородное золото; касситерит; висмутин; гарниерит; сфалерит</Data></Cell><Cell><Data ss:Type="String">Киноварь; криолит; сера</Data></Cell><Cell><Data ss:Type="String">Изумруд; пирит</Data></Cell></Row><Row><Cell><Data ss:Type="String">Интрузивные магматические</Data></Cell><Cell><Data ss:Type="String">Диорит</Data></Cell><Cell><Data ss:Type="String">Diorite</Data></Cell><Cell><Data ss:Type="String">Самородное серебро; самородное золото; касситерит; висмутин; гарниерит; сфалерит</Data></Cell><Cell><Data ss:Type="String">Криолит; сера</Data></Cell><Cell><Data ss:Type="String">Изумруд; пирит</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet><Worksheet ss:Name="Условия"><Table><Row><Cell ss:StyleID="Header"><Data ss:Type="String">Ресурс</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Где искать</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Условия генерации</Data></Cell></Row><Row><Cell><Data ss:Type="String">Самородная медь</Data></Cell><Cell><Data ss:Type="String">Эффузивные магматические породы; речные отложения</Data></Cell><Cell><Data ss:Type="String">Выше Y=40; речные отложения можно промывать лотком.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Самородное золото</Data></Cell><Cell><Data ss:Type="String">Эффузивные и интрузивные магматические породы; речные отложения</Data></Cell><Cell><Data ss:Type="String">Ниже Y=70; глубже жилы крупнее и богаче.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Самородное серебро</Data></Cell><Cell><Data ss:Type="String">Granite, Diorite, Schist, Gneiss; речные отложения</Data></Cell><Cell><Data ss:Type="String">Малые бедные жилы — Granite/Diorite в поднятиях выше Y=90. Большие богатые — Granite/Diorite/Schist/Gneiss ниже Y=20.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Тетраэдрит</Data></Cell><Cell><Data ss:Type="String">Метаморфические породы</Data></Cell><Cell><Data ss:Type="String">На любой высоте; глубокие жилы часто богаче.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Малахит</Data></Cell><Cell><Data ss:Type="String">Marble, Limestone, Chalk, Dolomite</Data></Cell><Cell><Data ss:Type="String">Глубже жилы часто крупнее и богаче.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Касситерит</Data></Cell><Cell><Data ss:Type="String">Интрузивные породы; речные отложения</Data></Cell><Cell><Data ss:Type="String">Выше Y=80 в районах поднятия или в дайках.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Висмутин</Data></Cell><Cell><Data ss:Type="String">Осадочные и интрузивные породы</Data></Cell><Cell><Data ss:Type="String">Осадочные — у поверхности; интрузивные — глубокие крупные богатые жилы.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Гарниерит</Data></Cell><Cell><Data ss:Type="String">Интрузивные породы, преимущественно Gabbro</Data></Cell><Cell><Data ss:Type="String">Ниже Y=0; небольшие редкие жилы возможны и в других интрузивных породах.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Гематит</Data></Cell><Cell><Data ss:Type="String">Эффузивные магматические породы</Data></Cell><Cell><Data ss:Type="String">Крупные жилы у поверхности.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Магнетит и лимонит</Data></Cell><Cell><Data ss:Type="String">Осадочные породы</Data></Cell><Cell><Data ss:Type="String">Крупные жилы у поверхности.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Сфалерит</Data></Cell><Cell><Data ss:Type="String">Эффузивные и интрузивные магматические породы</Data></Cell><Cell><Data ss:Type="String">Эффузивные — небольшие бедные жилы у поверхности; интрузивные — большие богатые глубоко.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Графит</Data></Cell><Cell><Data ss:Type="String">Gneiss, Marble, Quartzite, Schist</Data></Cell><Cell><Data ss:Type="String">Ниже Y=60; Slate не включён.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Киноварь</Data></Cell><Cell><Data ss:Type="String">Quartzite, Granite, Phyllite, Schist, Gneiss</Data></Cell><Cell><Data ss:Type="String">Глубоко под землёй или высоко в горах.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Криолит</Data></Cell><Cell><Data ss:Type="String">Granite, Diorite</Data></Cell><Cell><Data ss:Type="String">Глубокие жилы.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Сера</Data></Cell><Cell><Data ss:Type="String">Метаморфические и интрузивные магматические породы</Data></Cell><Cell><Data ss:Type="String">Глубоко под землёй, около уровня лавы.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Сильвит</Data></Cell><Cell><Data ss:Type="String">Shale, Claystone, Chert</Data></Cell><Cell><Data ss:Type="String">Очень большие плоские месторождения у поверхности.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Бура</Data></Cell><Cell><Data ss:Type="String">Claystone, Limestone, Shale</Data></Cell><Cell><Data ss:Type="String">Очень большие плоские месторождения у поверхности.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Лигнит и битумный уголь</Data></Cell><Cell><Data ss:Type="String">Осадочные породы</Data></Cell><Cell><Data ss:Type="String">Очень большие плоские месторождения у поверхности.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Селитра, гипс, галит</Data></Cell><Cell><Data ss:Type="String">Осадочные породы</Data></Cell><Cell><Data ss:Type="String">Очень большие плоские месторождения у поверхности.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Изумруд</Data></Cell><Cell><Data ss:Type="String">Интрузивные породы; горячие источники</Data></Cell><Cell><Data ss:Type="String">Тонкие вертикальные жилы до ~100 блоков; также связан с горячими источниками.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Кимберлит</Data></Cell><Cell><Data ss:Type="String">Gabbro; редко вулканические трещины</Data></Cell><Cell><Data ss:Type="String">Тонкие вертикальные кимберлитовые трубки до ~100 блоков; в породе — Gabbro.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Лазурит</Data></Cell><Cell><Data ss:Type="String">Limestone, Marble</Data></Cell><Cell><Data ss:Type="String">Редкие крупные жилы в диапазоне Y от −20 до 80.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Аметист</Data></Cell><Cell><Data ss:Type="String">Осадочные и метаморфические породы</Data></Cell><Cell><Data ss:Type="String">Под реками выше Y=40 или в жеодах ниже Y=30.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Опал</Data></Cell><Cell><Data ss:Type="String">Осадочные и эффузивные породы</Data></Cell><Cell><Data ss:Type="String">Под реками выше Y=40.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Пирит</Data></Cell><Cell><Data ss:Type="String">Интрузивные и эффузивные породы</Data></Cell><Cell><Data ss:Type="String">Ниже Y=70.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Рубин</Data></Cell><Cell><Data ss:Type="String">Marble</Data></Cell><Cell><Data ss:Type="String">Редко ниже Y=−10; чаще в мраморе Коллизионных гор.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Сапфир</Data></Cell><Cell><Data ss:Type="String">Трещины с горячими источниками</Data></Cell><Cell><Data ss:Type="String">Внутри геотермальных трещин.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Топаз</Data></Cell><Cell><Data ss:Type="String">Вулканические трещины</Data></Cell><Cell><Data ss:Type="String">Внутри вулканических трещин.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Каолинит</Data></Cell><Cell><Data ss:Type="String">Особые поверхностные ландшафты</Data></Cell><Cell><Data ss:Type="String">Плато, Древние горы, Rolling Hills и Highlands; температура ≥18 °C, осадки ≥300 мм. Кровавая лилия — индикатор.</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet><Worksheet ss:Name="Особые структуры"><Table><Row><Cell ss:StyleID="Header"><Data ss:Type="String">Тип</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Место / структура</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Ресурсы</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Как искать</Data></Cell></Row><Row><Cell><Data ss:Type="String">Речные отложения</Data></Cell><Cell><Data ss:Type="String">Речные отложения (River deposits)</Data></Cell><Cell><Data ss:Type="String">Самородная медь; золото; серебро; касситерит</Data></Cell><Cell><Data ss:Type="String">Промывка речных отложений лотком (panning).</Data></Cell></Row><Row><Cell><Data ss:Type="String">Геотермальные структуры</Data></Cell><Cell><Data ss:Type="String">Трещины с горячими источниками (Hot spring fissures)</Data></Cell><Cell><Data ss:Type="String">Сапфир; изумруд</Data></Cell><Cell><Data ss:Type="String">Сапфир внутри трещин горячих источников; изумруд также может быть связан с горячими источниками.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Вулканические структуры</Data></Cell><Cell><Data ss:Type="String">Вулканические трещины (Volcanic fissures)</Data></Cell><Cell><Data ss:Type="String">Топаз; кимберлит (редко)</Data></Cell><Cell><Data ss:Type="String">Топаз ищут внутри вулканических трещин; кимберлит там встречается редко.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Поверхностные ресурсы</Data></Cell><Cell><Data ss:Type="String">Каолиновая глина (Kaolin clay)</Data></Cell><Cell><Data ss:Type="String">Каолинит</Data></Cell><Cell><Data ss:Type="String">Плато, Древние горы, Rolling Hills и Highlands; температура ≥18 °C и осадки ≥300 мм. Кровавая лилия — индикатор.</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet><Worksheet ss:Name="Пояснения"><Table><Row><Cell ss:StyleID="Header"><Data ss:Type="String">Тема</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Пояснение</Data></Cell></Row><Row><Cell><Data ss:Type="String">Версия</Data></Cell><Cell><Data ss:Type="String">TerraFirmaCraft 1.21.1; Field Guide 1.21.1.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Координаты Y</Data></Cell><Cell><Data ss:Type="String">«Выше Y=40» означает Y &gt; 40; «ниже Y=20» означает Y &lt; 20.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Качественные условия</Data></Cell><Cell><Data ss:Type="String">«У поверхности», «глубоко», «высоко в горах» не переведены в числовые диапазоны, если источник не задаёт точный Y.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Slate / Schist / Shale</Data></Cell><Cell><Data ss:Type="String">Slate — аспидный сланец (метаморфический); Schist — сланец (метаморфический); Shale — сланец (осадочный). Это разные породы.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Групповые привязки</Data></Cell><Cell><Data ss:Type="String">Если Field Guide указывает геологическую группу, таблица показывает группу целиком и не придумывает ограничения для отдельных пород.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Вероятность</Data></Cell><Cell><Data ss:Type="String">Наличие подходящей породы и высоты не гарантирует жилу в конкретной точке.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Речные отложения</Data></Cell><Cell><Data ss:Type="String">Самородная медь, золото, серебро и касситерит также встречаются в речных отложениях и добываются промывкой.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Источник</Data></Cell><Cell><Data ss:Type="String">https://terrafirmacraft.github.io/Field-Guide/en_us/the_world/ores_and_minerals.html</Data></Cell></Row><Row><Cell><Data ss:Type="String">Дата подготовки</Data></Cell><Cell><Data ss:Type="String">21 ноября 2026 г.</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet></Workbook>